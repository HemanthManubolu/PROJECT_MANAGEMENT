generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_IN_REVIEW
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role     @default(DEVELOPER)
  refreshTokenVersion Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdProjects     Project[] @relation("ProjectCreator")
  managedProjects     Project[] @relation("ProjectManagerProjects")
  assignedTasks       Task[]    @relation("TaskAssignee")
  activityLogs        ActivityLog[]
  notifications       Notification[] @relation("NotificationRecipient")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
  @@index([name])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  clientId    String
  createdById String
  projectManagerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  projectManager User @relation("ProjectManagerProjects", fields: [projectManagerId], references: [id], onDelete: Restrict)
  tasks       Task[]
  activityLogs ActivityLog[]
  notifications Notification[]
  @@index([createdById])
  @@index([projectManagerId])
  @@index([clientId])
}

model Task {
  id                  String     @id @default(uuid())
  projectId           String
  title               String
  description         String?
  assignedDeveloperId String?
  status              TaskStatus @default(TODO)
  priority            Priority   @default(MEDIUM)
  dueDate             DateTime?
  isOverdue           Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  project             Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedDeveloper   User?      @relation("TaskAssignee", fields: [assignedDeveloperId], references: [id], onDelete: SetNull)
  activityLogs        ActivityLog[]
  notifications       Notification[]
  @@index([projectId])
  @@index([assignedDeveloperId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([projectId, status])
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String
  taskId    String
  userId    String
  action    String
  oldStatus TaskStatus?
  newStatus TaskStatus?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  projectId   String?
  taskId      String?
  type        NotificationType
  message     String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([recipientId])
  @@index([isRead])
  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}
